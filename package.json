{
  "name": "era-design-foundation",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "ERA: a multi-brand design system. Storybook for the foundations and components.",
  "scripts": {
    "tokens": "node tokens/build.mjs",
    "dev": "storybook dev -p 6006",
    "build": "npm run tokens && storybook build -o storybook-static",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "^8.6.14",
    "@storybook/addon-essentials": "^8.6.14",
    "@storybook/addon-themes": "^8.6.14",
    "@storybook/blocks": "^8.6.14",
    "@storybook/react": "^8.6.14",
    "@storybook/react-vite": "^8.6.14",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "storybook": "^8.6.14",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
