---
import Base from '../layouts/Base.astro';
import { COMPONENTS } from '../components.data';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const groups = [...new Set(COMPONENTS.map((c) => c.group))];
const sb = (story: string) => `${base}/storybook/?path=/story/${story}`;
---

<Base title="Components" description="What each component is for, when to use it, and when not to.">
  <h1>Components</h1>
  <p class="lede">
    Twenty-three components. The part worth reading on this page is not what they look like, which the
    <a href={sb('getting-started-overview--docs')}>Storybook</a> shows better, but when to reach for each one. Most component
    mistakes are choosing the wrong component, not styling the right one badly.
  </p>

  {groups.map((group) => (
    <>
      <h2>{group}</h2>
      {COMPONENTS.filter((c) => c.group === group).map((c) => (
        <section class="comp">
          <div class="comp__head">
            <h3 id={c.name.toLowerCase().replace(/\s+/g, '-')}>{c.name}</h3>
            <a class="comp__link" href={sb(c.story)}>Open in Storybook</a>
          </div>
          <p class="comp__purpose">{c.purpose}</p>
          <div class="comp__cols">
            <div class="comp__col comp__col--use">
              <div class="comp__col-title">Use it</div>
              <ul>{c.use.map((u) => <li>{u}</li>)}</ul>
            </div>
            <div class="comp__col comp__col--avoid">
              <div class="comp__col-title">Do not</div>
              <ul>{c.avoid.map((a) => <li>{a}</li>)}</ul>
            </div>
          </div>
        </section>
      ))}
    </>
  ))}
</Base>

<style>
  .comp {
    margin-block-end: var(--spacing-space-24);
    padding: var(--spacing-space-16);
    border: var(--brand-stroke-default) solid var(--sem-border-subtle);
    border-radius: var(--brand-radius-roles-card-md);
    background: var(--sem-bg-surface);
  }
  .comp__head { display: flex; align-items: baseline; justify-content: space-between; gap: var(--spacing-space-12); }
  .comp__head :global(h3) { margin: 0; }
  .comp__link { font-size: var(--typography-text-xs-size); white-space: nowrap; }
  .comp__purpose { margin: var(--spacing-space-4) 0 var(--spacing-space-16); color: var(--sem-fg-secondary); font-size: var(--typography-text-sm-size); }
  .comp__cols { display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: var(--spacing-space-12); }
  .comp__col {
    padding: var(--spacing-space-12);
    border-radius: var(--brand-radius-roles-card-sm);
    border-inline-start: var(--stroke-stroke-4) solid transparent;
  }
  .comp__col--use { background: var(--sem-status-success-bg-subtle); border-inline-start-color: var(--sem-status-success-border-strong); }
  .comp__col--avoid { background: var(--sem-status-error-bg-subtle); border-inline-start-color: var(--sem-status-error-border-strong); }
  .comp__col-title { font-size: var(--typography-text-xs-size); font-weight: var(--brand-typography-theme-font-weight-label); margin-block-end: var(--spacing-space-4); }
  .comp__col--use .comp__col-title { color: var(--sem-status-success-fg); }
  .comp__col--avoid .comp__col-title { color: var(--sem-status-error-fg); }
  .comp__col ul { margin: 0; padding-inline-start: var(--spacing-space-16); font-size: var(--typography-text-sm-size); }
  .comp__col li { margin-block-end: var(--spacing-space-4); color: var(--sem-fg-secondary); }
</style>
