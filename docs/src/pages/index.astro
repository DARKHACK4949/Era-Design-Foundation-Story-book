---
import Shell from '../layouts/Shell.astro';
import AppShot from '../components/AppShot.astro';
import Ramp from '../components/Ramp.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const BRANDS = [
  { id: 'brand-1', name: 'Brand 1', hue: 'Iris', face: 'IBM Plex Sans' },
  { id: 'brand-2', name: 'Brand 2', hue: 'Cyan', face: 'Geist' },
  { id: 'brand-3', name: 'Brand 3', hue: 'Jade', face: 'Source Sans 3' },
];
---

<Shell title="Overview" description="ERA is a multi-brand design system: three brands and two modes from one set of components.">
  <div class="home">
    <p class="pill">
      <span>v0.1. Twenty three components, three brands, two modes.</span>
      <a class="pill__cta" href={`${base}/storybook/`}>Open Storybook</a>
    </p>

    <section class="hero">
      <h1 class="hero__title">Three brands. One set of components.</h1>
      <p class="hero__lede">
        The variation lives in the tokens, not in the components. Switching brand or
        mode is two attributes on the page.
      </p>
      <p class="hero__cta">
        <a class="btn btn--solid" href={`${base}/foundations`}>Explore foundations</a>
        <a class="btn btn--quiet" href={`${base}/tokens`}>How tokens work</a>
      </p>
    </section>

    {/* The argument, before anyone scrolls. One screen, three brands, identical
        markup. The only differences are the accent, the typeface and the corner
        treatment, and all three are token decisions. */}
    <section class="shots" aria-label="The same screen in three brands">
      {BRANDS.map((b) => (
        <figure class="panel panel--tight shots__one">
          <AppShot brand={b.id} />
          <figcaption class="shots__cap">
            <strong>{b.name}, {b.hue}</strong>
            <span>{b.face}</span>
          </figcaption>
        </figure>
      ))}
    </section>

    <section class="panel">
      <h2 class="home__h2">Colour</h2>
      <p class="home__note">
        Eleven steps, each with a job. Two of them carry text, and that is on purpose.
        Switch brand above and only the first ramp moves.
      </p>
      <div class="home__ramps">
        <Ramp name="Brand" prefix="--brand-primary-scale" note="Iris, Cyan or Jade, depending on the brand above" />
        <Ramp name="Neutral" prefix="--brand-neutral" note="Surfaces, borders, text. Shared by all three" />
      </div>
    </section>

    <div class="home__pair">
      <section class="panel">
        <h2 class="home__h2">Type</h2>
        <p class="home__note">One typeface per brand. Nothing else about the type scale changes.</p>
        <ul class="faces">
          {BRANDS.map((b) => (
            <li class="faces__row" data-brand={b.id}>
              <span class="faces__name">{b.face}</span>
              <span class="faces__meta">{b.name}, {b.hue}</span>
            </li>
          ))}
        </ul>
      </section>

      <section class="panel home__audit">
        <p class="audit__figure">138</p>
        <p class="audit__of">of 138 pairs pass WCAG AA</p>
        <p class="home__note">
          Across three brands and both modes. One pair is deliberately below 4.5:1,
          the label on a disabled control, which WCAG 1.4.3 exempts.
        </p>
        <p><a href={`${base}/accessibility`}>See the measurements</a></p>
      </section>
    </div>
  </div>
</Shell>

<style>
  .home { display: grid; gap: var(--spacing-space-16); }

  /* --------------------------------------------------------------- pill */
  .pill {
    justify-self: center;
    display: flex; align-items: center; gap: var(--spacing-space-12);
    margin: var(--spacing-space-32) 0 0;
    padding: var(--spacing-space-4) var(--spacing-space-4) var(--spacing-space-4) var(--spacing-space-16);
    background: var(--sem-bg-surface-raised);
    border-radius: var(--radius-radius-full);
    font-size: var(--typography-text-sm-size);
    color: var(--sem-fg-secondary);
  }
  .pill__cta {
    padding: var(--spacing-space-4) var(--spacing-space-12);
    border-radius: var(--radius-radius-full);
    background: var(--sem-primary-bg);
    color: var(--sem-primary-fg-on-bg);
    text-decoration: none;
    font-weight: var(--brand-typography-theme-font-weight-label);
  }
  .pill__cta:hover { background: var(--sem-primary-bg-hover); color: var(--sem-primary-fg-on-bg); }

  /* --------------------------------------------------------------- hero */
  /* No panel. The hero is the page field itself, so the panels below are the
     first objects the eye lands on. */
  .hero { text-align: center; padding: var(--spacing-space-56) 0 var(--spacing-space-48); }
  .hero__title {
    margin: 0 auto;
    max-inline-size: 18ch;
    font-size: clamp(2.5rem, 5.2vw, 4.5rem);
    line-height: 1.02;
    letter-spacing: -0.03em;
    font-weight: var(--brand-typography-theme-font-weight-display);
  }
  .hero__lede {
    margin: var(--spacing-space-20) auto 0;
    max-inline-size: 54ch;
    font-size: var(--typography-text-lg-size);
    color: var(--sem-fg-secondary);
  }
  .hero__cta {
    display: flex; justify-content: center; gap: var(--spacing-space-12);
    margin-block-start: var(--spacing-space-32);
  }
  .btn {
    display: inline-flex; align-items: center;
    min-block-size: var(--spacing-space-40);
    padding-inline: var(--spacing-space-20);
    border-radius: var(--radius-radius-full);
    font-size: var(--typography-text-sm-size);
    font-weight: var(--brand-typography-theme-font-weight-label);
    text-decoration: none;
  }
  .btn--solid { background: var(--sem-fg-primary); color: var(--sem-bg-canvas); }
  .btn--solid:hover { background: var(--sem-fg-secondary); color: var(--sem-bg-canvas); }
  .btn--quiet { color: var(--sem-fg-secondary); }
  .btn--quiet:hover { background: var(--sem-state-hover); color: var(--sem-fg-primary); }

  /* -------------------------------------------------------------- shots */
  .shots { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--spacing-space-16); }
  @media (max-width: 1100px) { .shots { grid-template-columns: minmax(0, 1fr); } }
  .shots__one { margin: 0; }
  .shots__cap {
    display: flex; flex-wrap: wrap; gap: var(--spacing-space-8);
    align-items: baseline;
    margin-block-start: var(--spacing-space-16);
    font-size: var(--typography-text-sm-size);
  }
  .shots__cap span { color: var(--sem-fg-tertiary); }

  /* -------------------------------------------------------------- panels */
  .home__h2 { margin: 0 0 var(--spacing-space-8); font-size: var(--typography-text-2xl-size); }
  .home__note { margin: 0; max-inline-size: 62ch; color: var(--sem-fg-secondary); font-size: var(--typography-text-sm-size); }
  .home__ramps { margin-block-start: var(--spacing-space-24); }
  .home__pair { display: grid; grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr); gap: var(--spacing-space-16); }
  @media (max-width: 1000px) { .home__pair { grid-template-columns: minmax(0, 1fr); } }

  .faces { list-style: none; margin: var(--spacing-space-24) 0 0; padding: 0; display: grid; gap: var(--spacing-space-20); }
  .faces__row { display: flex; flex-wrap: wrap; gap: var(--spacing-space-12); align-items: baseline; }
  /* Each row carries its own brand, so each name is set in the face it names. */
  .faces__name {
    font-family: var(--brand-typography-theme-font-family-font);
    font-size: var(--typography-text-3xl-size);
    letter-spacing: -0.02em;
  }
  .faces__meta { font-size: var(--typography-text-sm-size); color: var(--sem-fg-tertiary); }

  .home__audit { display: grid; align-content: start; gap: var(--spacing-space-8); }
  .audit__figure {
    margin: 0;
    font-size: clamp(3.5rem, 7vw, 5.5rem);
    line-height: 1;
    letter-spacing: -0.04em;
    font-variant-numeric: tabular-nums;
    font-weight: var(--brand-typography-theme-font-weight-display);
  }
  .audit__of { margin: 0; font-size: var(--typography-text-lg-size); color: var(--sem-fg-secondary); }
</style>
