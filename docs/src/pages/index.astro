---
import Shell from '../layouts/Shell.astro';
import Chain from '../components/Chain.astro';
import Tiles from '../components/Tiles.astro';
import { Button } from '@era/components/button/Button';
import { Input } from '@era/components/input/Input';
import { Select } from '@era/components/select/Select';
import { Switch } from '@era/components/switch/Switch';
import { Badge } from '@era/components/badge/Badge';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const VENDORS = [
  { value: 'northwind', label: 'Northwind Supply', hint: '4 invoices this quarter' },
  { value: 'calder', label: 'Calder Logistics', hint: '2 invoices this quarter' },
];
const BRANDS = [
  ['brand-1', 'Brand 1', 'IBM Plex Sans'],
  ['brand-2', 'Brand 2', 'Geist'],
  ['brand-3', 'Brand 3', 'Source Sans 3'],
];
---

<Shell title="Overview" description="ERA is a multi-brand design system: three brands and two modes from one set of components.">
  <section class="hero">
    <div class="hero__copy">
      <h1 class="display">Three brands.<br />One set of components.</h1>
      <p class="lede">The variation lives in the tokens, not in the components. Switching brand or mode is two attributes on the page.</p>
      <div class="hero__cta">
        <a class="btn btn--solid lift" href={`${base}/foundations`}>Explore foundations</a>
        <a class="btn btn--quiet lift" href={`${base}/storybook/`}>Open Storybook</a>
      </div>
    </div>
    <div class="hero__art"><Chain /></div>
  </section>

  <section class="band">
    <p class="band__code mono">&lt;html data-brand="brand-2" data-theme="dark"&gt;</p>
    <p class="band__note">Change either attribute at the top of this page. Nothing below is aware of it.</p>
  </section>

  <section class="slab">
    <h2 class="slab__title">Foundations</h2>
    <Tiles />
  </section>

  <section class="slab">
    <h2 class="slab__title">The same panel, three brands</h2>
    <p class="slab__lede">Identical markup in each column. Typeface, accent and corner treatment are brand decisions; everything else is shared.</p>
    <div class="trio">
      {BRANDS.map(([id, name, face]) => (
        <div class="trio__col" data-brand={id}>
          <div class="trio__label">
            <strong>{name}</strong>
            <span>{face}</span>
          </div>
          <div class="panel">
            <div class="panel__head">
              <strong>Release rules</strong>
              <Badge tone="success" fill="subtle" dot>Active</Badge>
            </div>
            <Input label="Auto-release ceiling" defaultValue="500.00" client:load />
            <Select label="Vendor" options={VENDORS} defaultValue="calder" client:load />
            <Switch label="Hold first payment" defaultChecked client:load />
            <div class="panel__foot">
              <Button size="sm" client:load>Save rules</Button>
              <Button size="sm" intent="ghost" client:load>Cancel</Button>
            </div>
          </div>
        </div>
      ))}
    </div>
  </section>

  <section class="split">
    <div>
      <h2 class="slab__title">Take the tokens</h2>
      <p class="slab__lede">
        1,505 custom properties, no dependencies, no build step. Works under React, Vue, plain HTML, or as the theme layer
        beneath Tailwind.
      </p>
      <p><a href={`${base}/using-era`}>What you can and cannot use yet</a></p>
    </div>
    <pre class="code"><code>{`<link rel="stylesheet" href="era.css">

.my-button {
  background: var(--sem-primary-bg);
  color: var(--sem-primary-fg-on-bg);
  border-radius: var(--brand-radius-roles-buttons-button-md);
}`}</code></pre>
  </section>
</Shell>

<style>
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
    gap: var(--spacing-space-64);
    align-items: center;
    padding-block: var(--spacing-space-32) var(--spacing-space-64);
  }
  @media (max-width: 860px) { .hero { grid-template-columns: minmax(0, 1fr); gap: var(--spacing-space-32); } }

  .hero__copy .display { margin-block-end: var(--spacing-space-20); }
  .hero__cta { display: flex; gap: var(--spacing-space-12); flex-wrap: wrap; }

  .btn {
    display: inline-flex;
    align-items: center;
    min-block-size: var(--spacing-space-40);
    padding-inline: var(--spacing-space-16);
    border-radius: var(--brand-radius-roles-buttons-button-md);
    font-size: var(--typography-text-sm-size);
    font-weight: var(--brand-typography-theme-font-weight-label);
    text-decoration: none;
    white-space: nowrap;
  }
  .btn--solid { background: var(--sem-primary-bg); color: var(--sem-primary-fg-on-bg); }
  .btn--solid:hover { background: var(--sem-primary-bg-hover); }
  .btn--quiet { color: var(--sem-fg-primary); border: var(--brand-stroke-default) solid var(--sem-border-default); }
  .btn--quiet:hover { background: var(--sem-bg-surface-hover); }

  .band {
    padding: var(--spacing-space-24) 0;
    border-block: var(--brand-stroke-default) solid var(--sem-border-subtle);
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--spacing-space-16);
  }
  .band__code { font-size: var(--typography-text-sm-size); color: var(--sem-primary-fg); }
  .band__note { margin: 0; font-size: var(--typography-text-sm-size); color: var(--sem-fg-tertiary); }

  .slab { padding-block: var(--spacing-space-64) 0; }
  .slab__title {
    font-size: var(--typography-text-2xl-size);
    line-height: var(--typography-text-2xl-line-height);
    letter-spacing: -0.022em;
    font-weight: var(--brand-typography-theme-font-weight-heading);
    margin: 0 0 var(--spacing-space-8);
  }
  .slab__lede { margin: 0 0 var(--spacing-space-24); color: var(--sem-fg-secondary); max-inline-size: 60ch; }

  .trio { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--spacing-space-20); align-items: start; }
  @media (max-width: 900px) { .trio { grid-template-columns: minmax(0, 1fr); } }

  .trio__col { color: var(--sem-fg-primary); font-family: var(--brand-typography-theme-font-family-font); }
  .trio__label { display: flex; flex-direction: column; margin-block-end: var(--spacing-space-8); font-size: var(--typography-text-sm-size); }
  .trio__label span { font-size: var(--typography-text-xs-size); color: var(--sem-fg-tertiary); }

  .panel {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-space-16);
    padding: var(--spacing-space-16);
    border-radius: var(--brand-radius-roles-card-md);
    background: var(--sem-bg-surface);
    border: var(--brand-stroke-default) solid var(--sem-border-subtle);
  }
  .panel__head { display: flex; align-items: center; justify-content: space-between; gap: var(--spacing-space-8); }
  .panel__foot { display: flex; gap: var(--spacing-space-8); }

  .split {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: var(--spacing-space-48);
    align-items: center;
    padding-block: var(--spacing-space-64) 0;
  }
  @media (max-width: 860px) { .split { grid-template-columns: minmax(0, 1fr); gap: var(--spacing-space-24); } }
  .split .code { margin: 0; }
</style>
