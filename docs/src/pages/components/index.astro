---
import Shell from '../../layouts/Shell.astro';
import { COMPONENTS, slugify } from '../../components.data';
import { Preview, HAS_PREVIEW } from '../../components/previews';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const groups = [...new Set(COMPONENTS.map((c) => c.group))];
---

<Shell title="Components" section="components" prose={false} description="Twenty-three components, and when to reach for each one.">
  <h1 class="display">Components</h1>
  <p class="lede">
    Twenty-three of them. The useful question is not what each one looks like but when to reach for it, so every page
    opens with a playground and closes with the cases where you should pick something else.
  </p>

  {groups.map((group) => (
    <section class="grp">
      <h2 class="grp__title">{group}</h2>
      <div class="grid">
        {COMPONENTS.filter((c) => c.group === group).map((c) => {
          const slug = slugify(c.name);
          return (
            <article class="card lift">
              {/* inert, not aria-hidden: the preview is decorative, and some
                  components render their own links and buttons. Those must be
                  out of the tab order, and an anchor inside an anchor is
                  invalid HTML, which is why the card itself is no longer the
                  link. The name carries it and stretches over the card. */}
              <span class="card__stage" inert>
                {HAS_PREVIEW(slug)
                  ? <Preview slug={slug} />
                  : <span class="card__none">Shown on demand</span>}
              </span>
              <h3 class="card__name">
                <a class="card__link" href={`${base}/components/${slug}`}>{c.name}</a>
              </h3>
              <span class="card__purpose">{c.purpose.split('. ')[0].replace(/\.$/, '')}.</span>
            </article>
          );
        })}
      </div>
    </section>
  ))}
</Shell>

<style>
  .grp { padding-block-start: var(--spacing-space-48); }
  .grp__title {
    font-size: var(--typography-text-lg-size);
    letter-spacing: -0.015em;
    font-weight: var(--brand-typography-theme-font-weight-heading);
    margin: 0 0 var(--spacing-space-16);
    padding-block-end: var(--spacing-space-8);
    border-block-end: var(--brand-stroke-default) solid var(--sem-border-subtle);
  }
  .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); gap: var(--spacing-space-12); }
  .card {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: var(--spacing-space-4);
    padding: var(--spacing-space-12) var(--spacing-space-12) var(--spacing-space-16);
    border-radius: var(--radius-radius-16);
    background: var(--sem-bg-surface-raised);
    text-decoration: none;
    color: inherit;
    transition: background 160ms cubic-bezier(0.16, 1, 0.3, 1);
  }
  .card:hover { background: var(--sem-bg-surface-hover); }

  /* The component itself, at rest, on the sunken surface so the card reads as
     a frame around it rather than as another panel. A fixed height keeps the
     grid even whatever the component's own height is, and the preview is
     inert: the whole card is the link. */
  .card__stage {
    display: grid;
    place-items: center;
    block-size: var(--spacing-space-96);
    margin-block-end: var(--spacing-space-12);
    padding: var(--spacing-space-12);
    border-radius: var(--radius-radius-12);
    background: var(--sem-bg-surface-sunken);
    overflow: hidden;
    pointer-events: none;
  }
  .card__stage > * { max-inline-size: 100%; }
  .card__stage[inert] { opacity: 1; }
  .card__none { font-size: var(--typography-text-xs-size); color: var(--sem-fg-tertiary); }
  .card__name {
    margin: 0;
    font-size: var(--typography-text-base-size);
    font-weight: var(--brand-typography-theme-font-weight-label);
    letter-spacing: -0.01em;
  }
  .card__link { color: inherit; text-decoration: none; }
  /* The name is the link and it covers the card, so the whole tile is
     clickable without wrapping anything in an anchor. */
  .card__link::after { content: ''; position: absolute; inset: 0; border-radius: inherit; }
  .card__link:hover { color: var(--sem-fg-primary); }
  .card__purpose { font-size: var(--typography-text-sm-size); line-height: var(--typography-text-sm-line-height); color: var(--sem-fg-tertiary); }
</style>
