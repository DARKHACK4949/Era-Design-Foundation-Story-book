---
import Shell from '../../layouts/Shell.astro';
import { COMPONENTS, slugify } from '../../components.data';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const groups = [...new Set(COMPONENTS.map((c) => c.group))];
---

<Shell title="Components" section="components" prose={false} description="Twenty-three components, and when to reach for each one.">
  <h1 class="display">Components</h1>
  <p class="lede">
    Twenty-three of them. The useful question is not what each one looks like but when to reach for it, so every page
    opens with a playground and closes with the cases where you should pick something else.
  </p>

  {groups.map((group) => (
    <section class="grp">
      <h2 class="grp__title">{group}</h2>
      <div class="grid">
        {COMPONENTS.filter((c) => c.group === group).map((c) => (
          <a class="card lift" href={`${base}/components/${slugify(c.name)}`}>
            <span class="card__name">{c.name}</span>
            <span class="card__purpose">{c.purpose.split('. ')[0]}.</span>
          </a>
        ))}
      </div>
    </section>
  ))}
</Shell>

<style>
  .grp { padding-block-start: var(--spacing-space-48); }
  .grp__title {
    font-size: var(--typography-text-lg-size);
    letter-spacing: -0.015em;
    font-weight: var(--brand-typography-theme-font-weight-heading);
    margin: 0 0 var(--spacing-space-16);
    padding-block-end: var(--spacing-space-8);
    border-block-end: var(--brand-stroke-default) solid var(--sem-border-subtle);
  }
  .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(240px, 1fr)); gap: var(--spacing-space-12); }
  .card {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-space-4);
    padding: var(--spacing-space-16);
    border-radius: var(--brand-radius-roles-card-md);
    border: var(--brand-stroke-default) solid var(--sem-border-subtle);
    background: var(--sem-bg-surface);
    text-decoration: none;
    color: inherit;
    transition: border-color 160ms cubic-bezier(0.16, 1, 0.3, 1);
  }
  .card:hover { border-color: var(--sem-border-default); }
  .card__name { font-weight: var(--brand-typography-theme-font-weight-label); letter-spacing: -0.01em; }
  .card__purpose { font-size: var(--typography-text-sm-size); line-height: var(--typography-text-sm-line-height); color: var(--sem-fg-tertiary); }
</style>
