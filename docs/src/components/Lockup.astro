---
interface Props { height?: number }
const { height = 24 } = Astro.props;
/* The wordmark is drawn, not typeset. This site sets its typeface from the
   active brand token, so a text wordmark changed face whenever somebody
   switched brand, which made the system's own identity a function of the
   brands it serves. In a branded house the parent stays put.

   Clear space between mark and word is two square sides of the mark, measured
   from its bounding box. */
---
{height < 32 ? (
  <svg height={height} viewBox="0 -6.40 322.11 82.80" fill="currentColor" role="img" aria-label="ERA" focusable="false">
    <g transform="translate(0,-6.40) scale(0.6571)"><rect x="0"  y="90" width="36" height="36" rx="9"/>
    <rect x="45" y="45" width="36" height="36" rx="9"/>
    <rect x="90" y="0"  width="36" height="36" rx="9"/></g>
    <g transform="translate(130.11,0)"><g fill="currentColor"><path fill="none" stroke="currentColor" stroke-width="10" d="M43.0 5.0 H5.0 V67.0 H43.0"/><path fill="none" stroke="currentColor" stroke-width="10" d="M5.0 36.0 H39.0"/><g transform="translate(74,0)"><path fill="none" stroke="currentColor" stroke-width="10" d="M5.0 72 V5.0 H28 A15 15 0 0 1 28 35 H5.0"/><path d="M20 35 H32.54 L48 72 H35.46 Z"/></g><g transform="translate(140,0)"><path d="M0 72 L26.0 -2 L52 72 H42.00 L26.0 26.45 L10.00 72 Z"/></g></g></g>
  </svg>
) : (
  <svg height={height} viewBox="0 -6.40 322.11 82.80" fill="currentColor" role="img" aria-label="ERA" focusable="false">
    <g transform="translate(0,-6.40) scale(0.6571)"><path fill-rule="evenodd" clip-rule="evenodd" d="M9 90C4.02944 90 0 94.0294 0 99V117C0 121.971 4.02944 126 9 126H27C31.9706 126 36 121.971 36 117V99C36 94.0294 31.9706 90 27 90H9ZM9 99H27V117H9V99Z"/>
    <path fill-rule="evenodd" clip-rule="evenodd" d="M54 45C49.0294 45 45 49.0294 45 54V72C45 76.9706 49.0294 81 54 81H72C76.9706 81 81 76.9706 81 72V54C81 49.0294 76.9706 45 72 45H54ZM54 54H63V72H54V54Z"/>
    <rect x="90" y="0" width="36" height="36" rx="9"/></g>
    <g transform="translate(130.11,0)"><g fill="currentColor"><path fill="none" stroke="currentColor" stroke-width="10" d="M43.0 5.0 H5.0 V67.0 H43.0"/><path fill="none" stroke="currentColor" stroke-width="10" d="M5.0 36.0 H39.0"/><g transform="translate(74,0)"><path fill="none" stroke="currentColor" stroke-width="10" d="M5.0 72 V5.0 H28 A15 15 0 0 1 28 35 H5.0"/><path d="M20 35 H32.54 L48 72 H35.46 Z"/></g><g transform="translate(140,0)"><path d="M0 72 L26.0 -2 L52 72 H42.00 L26.0 26.45 L10.00 72 Z"/></g></g></g>
  </svg>
)}
