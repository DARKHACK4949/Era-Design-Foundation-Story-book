---
import { MagnifyingGlass, SunDim, MoonStars, GithubLogo } from '@phosphor-icons/react';
import { PRIMARY } from '../nav';
import Mark from './Mark.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const here = Astro.url.pathname.replace(base, '').replace(/\/$/, '') || '/';

const BRANDS = [
  { id: 'brand-1', name: 'Brand 1, Iris', swatch: 'var(--colors-iris-700)' },
  { id: 'brand-2', name: 'Brand 2, Cyan', swatch: 'var(--colors-cyan-700)' },
  { id: 'brand-3', name: 'Brand 3, Jade', swatch: 'var(--colors-jade-700)' },
];
---

<header class="chrome">
  <a class="wordmark lift" href={base || '/'}>
    <Mark size={24} />
    <span class="wordmark__name">ERA</span>
  </a>

  <nav class="chrome__nav" aria-label="Sections">
    {PRIMARY.map((l) => (
      <a class="chrome__link" href={`${base}${l.href}`} aria-current={here.startsWith(l.href) ? 'page' : undefined}>
        {l.label}
      </a>
    ))}
  </nav>

  <div class="chrome__spacer"></div>

  <div class="chrome__tools">
    <div class="brands" role="group" aria-label="Brand">
      {BRANDS.map((b) => (
        <button type="button" class="brands__btn" data-brand-btn={b.id} aria-label={b.name} title={b.name} style={`background: ${b.swatch}`} />
      ))}
    </div>

    <button type="button" class="icon-btn" data-mode-btn aria-label="Switch between light and dark">
      <span data-mode-icon="light" aria-hidden="true"><SunDim size={18} weight="regular" /></span>
      <span data-mode-icon="dark" hidden aria-hidden="true"><MoonStars size={18} weight="regular" /></span>
    </button>

    <button type="button" class="icon-btn" data-search-open aria-label="Search, press slash">
      <MagnifyingGlass size={18} weight="regular" />
    </button>

    <span class="chip">v0.1</span>

    <a class="icon-btn" href="https://github.com/DARKHACK4949/Era-Design-Foundation-Story-book" aria-label="Source on GitHub">
      <GithubLogo size={18} weight="regular" />
    </a>
  </div>
</header>

<script is:inline>
  (function () {
    var root = document.documentElement;

    // Per-viewer convenience only. It throws in a private window, so every
    // touch is guarded and the page renders correctly without it.
    function read(k, d) { try { return localStorage.getItem(k) || d; } catch (e) { return d; } }
    function write(k, v) { try { localStorage.setItem(k, v); } catch (e) {} }

    function applyBrand(id) {
      root.setAttribute('data-brand', id);
      syncScopes(root.getAttribute('data-theme') || 'light');
      document.querySelectorAll('[data-brand-btn]').forEach(function (b) {
        b.setAttribute('aria-pressed', String(b.getAttribute('data-brand-btn') === id));
      });
      write('era-brand', id);
    }

    // A custom property is substituted where it is DECLARED, so the semantic
    // layer declared on <html> resolves against <html>'s brand. A nested
    // [data-brand] block therefore needs the semantic layer redeclared on it
    // too, which means carrying the current mode down with it.
    function syncScopes(mode) {
      document.querySelectorAll('[data-brand]').forEach(function (el) {
        if (el !== root) el.setAttribute('data-theme', mode);
      });
    }

    function applyMode(mode) {
      root.setAttribute('data-theme', mode);
      root.style.colorScheme = mode;
      syncScopes(mode);
      document.querySelectorAll('[data-mode-icon]').forEach(function (el) {
        el.hidden = el.getAttribute('data-mode-icon') !== mode;
      });
      write('era-mode', mode);
    }

    applyBrand(read('era-brand', 'brand-1'));
    var prefersDark = window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches;
    applyMode(read('era-mode', prefersDark ? 'dark' : 'light'));

    document.addEventListener('click', function (e) {
      var t = e.target.closest ? e.target : e.target.parentElement;
      if (!t || !t.closest) return;
      var brandBtn = t.closest('[data-brand-btn]');
      if (brandBtn) applyBrand(brandBtn.getAttribute('data-brand-btn'));
      if (t.closest('[data-mode-btn]')) applyMode(root.getAttribute('data-theme') === 'dark' ? 'light' : 'dark');
    });

    // The header only needs an edge once content is actually underneath it.
    var ticking = false;
    function onScroll() {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(function () {
        document.body.setAttribute('data-scrolled', String(window.scrollY > 4));
        ticking = false;
      });
    }
    document.addEventListener('scroll', onScroll, { passive: true });
    onScroll();
  })();
</script>
