---
import { COMPONENTS, slugify } from '../components.data';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

/** A real index, built at compile time. No service, no network call. */
const INDEX = [
  { label: 'Overview', kind: 'Page', href: `${base}/` },
  { label: 'Adopting ERA', kind: 'Page', href: `${base}/using-era` },
  { label: 'How tokens work', kind: 'Page', href: `${base}/tokens` },
  { label: 'Accessibility', kind: 'Page', href: `${base}/accessibility` },
  { label: 'Foundations', kind: 'Page', href: `${base}/foundations` },
  { label: 'Colour', kind: 'Foundation', href: `${base}/foundations/colour` },
  { label: 'Typography', kind: 'Foundation', href: `${base}/foundations/typography` },
  { label: 'Spacing', kind: 'Foundation', href: `${base}/foundations/spacing` },
  { label: 'Radius and stroke', kind: 'Foundation', href: `${base}/foundations/shape` },
  ...COMPONENTS.map((c) => ({ label: c.name, kind: 'Component', href: `${base}/components/${slugify(c.name)}` })),
];
---

<dialog class="search" data-search>
  <div class="search__field">
    <input type="search" class="search__input" placeholder="Search ERA" aria-label="Search ERA" data-search-input autocomplete="off" />
    <kbd class="search__esc">Esc</kbd>
  </div>
  <ul class="search__results" data-search-results role="listbox" aria-label="Results"></ul>
  <p class="search__empty" data-search-empty hidden>Nothing matches that.</p>
</dialog>

<script is:inline define:vars={{ INDEX }}>
  (function () {
    var dialog = document.querySelector('[data-search]');
    var input = document.querySelector('[data-search-input]');
    var list = document.querySelector('[data-search-results]');
    var empty = document.querySelector('[data-search-empty]');
    if (!dialog || !input || !list) return;
    var active = 0, shown = [];

    function render(q) {
      var needle = q.trim().toLowerCase();
      shown = needle
        ? INDEX.filter(function (i) { return i.label.toLowerCase().includes(needle); }).slice(0, 8)
        : INDEX.slice(0, 6);
      active = 0;
      list.innerHTML = shown.map(function (i, n) {
        return '<li role="option" aria-selected="' + (n === 0) + '" data-i="' + n + '">' +
          '<a href="' + i.href + '"><span>' + i.label + '</span><span class="search__kind">' + i.kind + '</span></a></li>';
      }).join('');
      empty.hidden = shown.length > 0;
    }

    function move(d) {
      if (!shown.length) return;
      active = (active + d + shown.length) % shown.length;
      [].forEach.call(list.children, function (li, n) { li.setAttribute('aria-selected', String(n === active)); });
      list.children[active].scrollIntoView({ block: 'nearest' });
    }

    function open() {
      render('');
      input.value = '';
      if (!dialog.open) dialog.showModal();
      input.focus();
    }

    document.addEventListener('click', function (e) {
      if (e.target.closest && e.target.closest('[data-search-open]')) open();
      // Clicking the backdrop means clicking the dialog element itself.
      if (e.target === dialog) dialog.close();
    });

    document.addEventListener('keydown', function (e) {
      if (e.key === '/' && !/^(INPUT|TEXTAREA|SELECT)$/.test(document.activeElement.tagName)) {
        e.preventDefault();
        open();
      }
    });

    input.addEventListener('input', function () { render(input.value); });
    dialog.addEventListener('keydown', function (e) {
      if (e.key === 'ArrowDown') { e.preventDefault(); move(1); }
      else if (e.key === 'ArrowUp') { e.preventDefault(); move(-1); }
      else if (e.key === 'Enter' && shown[active]) { e.preventDefault(); window.location.href = shown[active].href; }
    });
  })();
</script>

<!-- Global, not scoped: the result rows are created at runtime and would not
     carry Astro's scope attribute, so scoped rules would never reach them. -->
<style is:global>
  .search {
    inline-size: min(520px, calc(100vw - var(--spacing-space-32)));
    padding: 0;
    border: var(--brand-stroke-default) solid var(--sem-border-subtle);
    border-radius: var(--brand-radius-roles-surface-modal);
    background: var(--sem-bg-surface-overlay);
    color: var(--sem-fg-primary);
    font-family: var(--brand-typography-theme-font-family-font);
    box-shadow: 0 24px 64px var(--colors-alpha-black-24);
    margin-block-start: 12vh;
  }
  .search::backdrop { background: var(--sem-bg-scrim); backdrop-filter: blur(4px); }

  .search__field { display: flex; align-items: center; gap: var(--spacing-space-8); padding: var(--spacing-space-12) var(--spacing-space-16); }
  .search__input {
    flex: 1 1 auto;
    min-inline-size: 0;
    background: none;
    border: 0;
    padding: 0;
    font: inherit;
    font-size: var(--typography-text-base-size);
    color: inherit;
  }
  .search__input:focus { outline: none; }
  .search__input::placeholder { color: var(--sem-form-input-placeholder); }
  .search__esc {
    font-size: var(--typography-text-xs-size);
    color: var(--sem-fg-tertiary);
    border: var(--brand-stroke-default) solid var(--sem-border-subtle);
    border-radius: var(--brand-radius-scale-sm-4);
    padding: 1px var(--spacing-space-4);
  }

  .search__results { list-style: none; margin: 0; padding: var(--spacing-space-4); max-block-size: 320px; overflow-y: auto; border-block-start: var(--brand-stroke-default) solid var(--sem-border-subtle); }
  .search__results a {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--spacing-space-12);
    padding: var(--spacing-space-8) var(--spacing-space-12);
    border-radius: var(--brand-radius-roles-menu-items-md);
    color: inherit;
    text-decoration: none;
    font-size: var(--typography-text-sm-size);
  }
  .search__results li[aria-selected='true'] a { background: var(--sem-state-selected); color: var(--sem-primary-fg); }
  .search__kind { font-size: var(--typography-text-xs-size); color: var(--sem-fg-tertiary); }
  .search__empty { padding: var(--spacing-space-16); margin: 0; color: var(--sem-fg-tertiary); font-size: var(--typography-text-sm-size); text-align: center; }
</style>
