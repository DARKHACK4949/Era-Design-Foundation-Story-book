---
/**
 * A framed preview. It inherits the brand and mode from <html>, so a demo
 * cannot drift from whatever the toolbar at the top is set to.
 */
interface Props { label?: string; padded?: boolean }
const { label, padded = true } = Astro.props;
---

<figure class="demo">
  <div class="demo__stage" style={padded ? '' : 'padding: 0'}>
    <slot />
  </div>
  {label && <figcaption class="demo__caption">{label}</figcaption>}
</figure>

<style>
  .demo {
    margin: 0 0 var(--spacing-space-16);
    border: var(--brand-stroke-default) solid var(--sem-border-subtle);
    border-radius: var(--brand-radius-roles-card-md);
    overflow: hidden;
    background: var(--sem-bg-surface);
  }
  .demo__stage {
    padding: var(--spacing-space-24);
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    gap: var(--spacing-space-12);
  }
  .demo__caption {
    padding: var(--spacing-space-8) var(--spacing-space-12);
    border-block-start: var(--brand-stroke-default) solid var(--sem-border-subtle);
    background: var(--sem-bg-surface-sunken);
    font-size: var(--typography-text-xs-size);
    color: var(--sem-fg-tertiary);
  }
</style>
