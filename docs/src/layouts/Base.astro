---
import '../../../tokens/generated/era.css';
import '../styles/docs.css';
import Switcher from '../components/Switcher.astro';
import { NAV } from '../nav';

interface Props { title: string; description?: string }
const { title, description = 'ERA, a multi-brand design system.' } = Astro.props;

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const here = Astro.url.pathname.replace(base, '').replace(/\/$/, '') || '/';
const storybook = `${base}/storybook/`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} · ERA</title>
    <meta name="description" content={description} />
    <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 16 16'><circle cx='8' cy='8' r='7' fill='%235b5bd6'/></svg>" />
  </head>
  <body>
    <div class="shell">
      <header class="topbar">
        <a class="brand" href={base || '/'}>
          <span class="brand__mark">ERA</span>
          <span class="brand__sub">Design system</span>
        </a>
        <div class="topbar__spacer"></div>
        <Switcher />
        <nav class="topbar__links" aria-label="Elsewhere">
          <a class="topbar__link" href={storybook}>Storybook</a>
          <a class="topbar__link" href="https://github.com/DARKHACK4949/Era-Design-Foundation-Story-book">GitHub</a>
        </nav>
      </header>

      <div class="body">
        <nav class="sidebar" aria-label="Documentation">
          {NAV.map((group) => (
            <div class="sidebar__group">
              <div class="sidebar__title">{group.title}</div>
              <ul class="sidebar__list">
                {group.links.map((link) => (
                  <li>
                    <a
                      class="sidebar__link"
                      href={`${base}${link.href === '/' ? '/' : link.href}`}
                      aria-current={here === link.href ? 'page' : undefined}
                    >
                      {link.label}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </nav>

        <main class="prose">
          <slot />
        </main>
      </div>

      <footer class="footer">
        ERA is a personal design system by Sanyam Sharma. MIT licensed.
      </footer>
    </div>
  </body>
</html>
