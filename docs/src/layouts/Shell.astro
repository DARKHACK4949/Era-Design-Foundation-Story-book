---
// The three brand typefaces, self-hosted. Without these the brand font tokens
// fall back to the system stack and all three brands look identical.
import '@fontsource-variable/ibm-plex-sans';
import '@fontsource-variable/geist';
import '@fontsource-variable/source-sans-3';
import '../../../tokens/generated/era.css';
import '../styles/docs.css';
import Chrome from '../components/Chrome.astro';
import Rail from '../components/Rail.astro';
import Search from '../components/Search.astro';
import { SECTIONS } from '../nav';

interface Props { title: string; description?: string; section?: keyof typeof SECTIONS | null; prose?: boolean }
const { title, description = 'ERA, a multi-brand design system.', section = null, prose = Boolean(Astro.props.section) } = Astro.props;

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const here = Astro.url.pathname.replace(base, '').replace(/\/$/, '') || '/';
const groups = section ? SECTIONS[section] : null;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} · ERA</title>
    <meta name="description" content={description} />
    <meta name="color-scheme" content="light dark" />
    <link rel="icon" type="image/svg+xml" href={`${base}/mark.svg`} />
  </head>
  <body>
    <Chrome />

    <div class={groups ? 'layout' : 'layout layout--wide'}>
      <Rail />

      {groups && (
        <nav class="side" aria-label="In this section">
          {groups.map((group) => (
            <div class="side__group">
              <div class="side__title">{group.title}</div>
              <ul class="side__list">
                {group.links.map((link) => (
                  <li>
                    <a class="side__link" href={`${base}${link.href}`} aria-current={here === link.href ? 'page' : undefined}>
                      {link.label}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </nav>
      )}

      {/* A prose page is one region, so it is one panel. The home page sets
          prose to false and lays out its own panels instead. */}
      <main class={prose ? 'panel' : undefined}>
        {prose ? <div class="prose"><slot /></div> : <slot />}
      </main>
    </div>

    <footer class="foot">
      <span>ERA, a personal design system by Sanyam Sharma.</span>
      <span class="chrome__spacer"></span>
      <a href={`${base}/using-era`}>Adopt</a>
      <a href={`${base}/storybook/`}>Storybook</a>
      <a href="https://github.com/DARKHACK4949/Era-Design-Foundation-Story-book">Source</a>
      <a href="https://sanyam.space" target="_blank" rel="noopener">Portfolio</a>
      <a href="https://www.linkedin.com/in/sanyamsharma98" target="_blank" rel="noopener">LinkedIn</a>
      <a href="mailto:sanyamsharma4978@gmail.com">Email</a>
      <span>MIT</span>
    </footer>

    <p class="foot__colophon"><span>Colour scales start from Radix Colors and are re-pointed per brand. Set in IBM Plex Sans, Geist and Source Sans 3, one typeface per brand.</span></p>

    <Search />
  </body>
</html>
