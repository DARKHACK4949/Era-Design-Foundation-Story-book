---
// The three brand typefaces, self-hosted. Without these the brand font tokens
// fall back to the system stack and all three brands look identical.
import '@fontsource-variable/ibm-plex-sans';
import '@fontsource-variable/geist';
import '@fontsource-variable/source-sans-3';
import '../../../tokens/generated/era.css';
import '../styles/docs.css';
import Chrome from '../components/Chrome.astro';
import Rail from '../components/Rail.astro';
import Toc from '../components/Toc.astro';
import Search from '../components/Search.astro';
import { sectionFor } from '../nav';

interface Props { title: string; description?: string; section?: string | null; prose?: boolean }
const { title, description = 'ERA, a multi-brand design system.', prose = Boolean(Astro.props.section) } = Astro.props;

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const here = Astro.url.pathname.replace(base, '').replace(/\/$/, '') || '/';
/* The section comes from the navigation itself rather than from a prop each
   page repeats. A page that said it was somewhere the nav did not list it
   would highlight one place and open another. */
const active = sectionFor(here);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} · ERA</title>
    <meta name="description" content={description} />
    <meta name="color-scheme" content="light dark" />
    <link rel="icon" type="image/svg+xml" href={`${base}/mark.svg`} />
    {/* Before first paint, so the rail is already the width it should be when
        the page appears. Set after paint it would be a visible jump on every
        navigation, which is exactly the seam this nav is trying not to have.
        The section this page belongs to is the server's answer; the rail width
        is the viewer's, remembered from last time. */}
    <script is:inline define:vars={{ active }}>
      (function () {
        var d = document.documentElement;
        var rail = 'labels';
        try { rail = localStorage.getItem('era-rail') || (active ? 'icons' : 'labels'); } catch (e) { rail = active ? 'icons' : 'labels'; }
        d.setAttribute('data-rail', rail);
        d.setAttribute('data-flyout', active || '');
      })();
    </script>
  </head>
  <body>
    <Chrome />

    <div class="layout">
      <Rail />

      {/* The only scrolling region. The rail, the section list and the
          contents list sit outside it, so they do not move at all when the
          page is read, which is how the reference sites behave. The footer
          lives in here for the same reason. */}
      <div class="scroller">
        {/* A prose page is one region, so it is one panel. The home page sets
            prose to false and lays out its own panels instead. */}
        <main class={prose ? "content" : undefined}>
          {prose ? <div class="prose"><slot /></div> : <slot />}
        </main>

        <footer class="foot">
      <span>ERA, a personal design system by Sanyam Sharma.</span>
      <span class="chrome__spacer"></span>
      <a href={`${base}/using-era`}>Adopt</a>
      <a href={`${base}/storybook/`}>Storybook</a>
      <a href="https://github.com/DARKHACK4949/Era-Design-Foundation-Story-book">Source</a>
      <a href="https://sanyam.space" target="_blank" rel="noopener">Portfolio</a>
      <a href="https://www.linkedin.com/in/sanyamsharma98" target="_blank" rel="noopener">LinkedIn</a>
      <a href="mailto:sanyamsharma4978@gmail.com">Email</a>
      <span>MIT</span>
        </footer>

        <p class="foot__colophon"><span>Colour scales start from Radix Colors and are re-pointed per brand. Set in IBM Plex Sans, Geist and Source Sans 3, one typeface per brand.</span></p>
      </div>

      {prose && <Toc />}
    </div>

    <Search />
  </body>
</html>
